{
  "name": "anythinggacha-studio",
  "version": "1.0.0",
  "description": "AnythingGacha Studio - Photocard Binder",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable",
    "build:mac": "electron-builder --mac --x64 --arm64",
    "build:linux": "electron-builder --linux AppImage",
    "build:all": "electron-builder --win --mac --linux"
  },
  "build": {
    "appId": "com.anythinggacha.studio",
    "productName": "AnythingGacha Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.entertainment",
      "identity": null
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}