{
  "name": "anythinggacha-studio",
  "version": "1.0.0",
  "description": "Collect anything - Photocard gacha game and binder",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:win": "electron-builder --win portable"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s0ulcodes/anythinggacha.git"
  },
  "keywords": ["gacha", "photocard", "collectible", "binder"],
  "author": "s0ulcodes",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/s0ulcodes/anythinggacha/issues"
  },
  "homepage": "https://github.com/s0ulcodes/anythinggacha#readme",
  "build": {
    "appId": "com.anythinggacha.studio",
    "productName": "AnythingGacha Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
